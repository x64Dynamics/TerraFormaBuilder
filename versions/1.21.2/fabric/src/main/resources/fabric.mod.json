{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.x64Dynamics.tfb.Entrypoint"
    ],
    "client": [
      "com.x64Dynamics.tfb.client.ClientEntrypoint"
    ]
  },
  "mixins": [
    "terraformabuilder.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_release}"
  }
}
